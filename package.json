{
  "name": "vlingo-api",
  "version": "1.0.0",
  "description": "VLINGO AI Backend - English learning assistant powered by local LLM via Ollama",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "ingest": "node scripts/ingest.js",
    "pull-model": "ollama pull llama3.2:3b",
    "setup": "npm install && npm run pull-model"
  },
  "dependencies": {
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.38",
    "@langchain/ollama": "^1.2.6",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "langchain": "^1.2.39",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "ollama": "^0.5.0",
    "pdf-parse": "^1.1.4",
    "uuid": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
